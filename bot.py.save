import asyncio
import logging

from aiogram import Bot, Dispatcher
from aiogram.client.default import DefaultBotProperties
from aiogram.client.session.aiohttp import AiohttpSession
from aiogram.enums import ParseMode

from config import load_config
from database import Database
from handlers import router
from scheduler import ReminderScheduler


async def main() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(name)s: %(message)s",
    )

    config = load_config()

    bot_kwargs = dict(
        token=config.bot_token,
        default=DefaultBotProperties(parse_mode=ParseMode.HTML),
    )
    if config.proxy_url:
        bot_kwargs["session"] = AiohttpSession(proxy=config.proxy_url)
        logging.getLogger(__name__).info("Используется прокси для подключения к Telegram.")
    bot = Bot(**bot_kwargs)

    db = Database(config.db_path)
    await db.init()

    scheduler = ReminderScheduler(bot, db, config.timezone)
    scheduler.start()
    await scheduler.reschedule_all()

    dp = Dispatcher()
    dp.include_router(router)

    logging.getLogger(__name__).info("Бот запущен.")
    try:
        await dp.start_polling(bot, db=db, scheduler=scheduler, config=config)
    finally:
        await db.close()


if __name__ == "__main__":
    asyncio.run(main())
